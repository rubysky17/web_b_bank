# Copy to .env.local and edit. Only VITE_* variables reach the bundle — never put secrets here.
# Q Bank API base URL (with the /api/v1 prefix). Defaults to production when unset.
VITE_API_URL=https://back-q-bank.vodat10998.workers.dev/api/v1

# Local backend (`npm run dev` in back_q_bank):
# VITE_API_URL=http://localhost:8787/api/v1

# Help & feedback in Settings opens a mail to this address; the row hides when empty.
VITE_SUPPORT_EMAIL=
